sap.service.layer.url=https://localhost:500000
sap.service.layer.user=usuario
sap.service.layer.password=senha
sap.service.layer.companyDB=base



uzzipay.host=https://openhml-api.uzzipay.com
uzzipay.contas[0].cnpj=1
uzzipay.contas[0].privateKey=private
uzzipay.contas[0].chavePix=chavePix
uzzipay.contas[0].chave-pix=chavePix
uzzipay.contas[0].tokenJwt=jwt
pix.schedule.enable=false
pix.schedule.delay-minutes=5
pix.schedule.consulta-interval-minutes=5
# Taxa de mora do PIX em % AO DIA, multiplicada pelos dias de atraso. 0.1 = 3% ao mes (pro rata die); 0 = sem juros.
# Vale para o PIX de titulo (contas a receber) e para o PIX dos boletos de contrato de venda futura.
pix.juros.mora.percent=0.1

# Bloqueia retirada de venda futura quando ha titulo vencido do proprio contrato.
# Variavel de ambiente equivalente: VENDA_FUTURA_BLOQUEIO_RETIRADA_INADIMPLENCIA=false
# para desativar. Se nao for informada, o bloqueio permanece ligado.
venda-futura.bloqueio-retirada-inadimplencia=true

# ----- Autenticacao via Keycloak (toggle) -----
# Quando habilitado, o backend passa a aceitar tokens do Keycloak (RS256, via
# JWKS) e o /auth/config instrui o front-sap a usar o fluxo OIDC. Os tokens
# internos do /otp/login (cliente externo) continuam sendo aceitos.
keycloak.enabled=false
keycloak.url=https://keycloak.exemplo.com
keycloak.realm=rovema
keycloak.client-id=front-sap
# Claim opcional que carrega o codigo SAP do usuario (default: sap_code)
keycloak.sap-id-claim=sap_code

# ----- Vendas offline / catalogos antecipados -----
offline.enabled=false
offline.catalog.ttl-hours=72
offline.catalog.max-concurrency=1
offline.catalog.lease-minutes=60
offline.catalog.prewarm-hours=12
offline.catalog.part-size-bytes=4194304
spring.data.redis.host=localhost
spring.data.redis.port=6379

# ----- Rotinas agendadas (substituem o antigo org.quartz.enable) -----
# Cada rotina tem seu proprio toggle e vem DESATIVADA por padrao.
# Aprovacao automatica de rascunhos de pedido (AutoApprovalPaymentCondition) - a cada 5 min
jobs.aprovacao-automatica.enable=false
# Fluxo de prazo / atualizacao cadastral de parceiros (FluxoPrazoFluxo) - a cada 5 min
jobs.fluxo-prazo.enable=false
# Atualizacao da cotacao de moeda no Bacen (CurrencyScheduled) - diaria a meia-noite
jobs.cotacao-moeda.enable=false

# ----- Centro de custo em lancamento contabil (AtualizarCentrodeCustoLancamentoSchedule) -----
# Roda a cada 60s e preenche as dimensoes de rateio (CostingCode = grupo economico,
# CostingCode2 = centro de custo) dos lancamentos com U_Atualizar_Centro_de_Custo = 0.
lc.centrodecusto.grupoeconomico.enable=false
# Janela de dias para tras. Aumentar para alcancar backlog antigo - cuidado: o job dara
# PATCH em todo lancamento da janela, so para marcar o UDF de processado.
lc.centrodecusto.dias=5
# Contas que recebem o rateio quando a linha esta sem dimensao, na filial abaixo.
lc.centrodecusto.contas=4.9.1.001.00001,4.2.1.001.00007
lc.centrodecusto.filial=2
lc.centrodecusto.grupo-economico=500
lc.centrodecusto.centro-custo=50000205
# Padrao por filial, no formato filial:grupoEconomico:centroCusto separado por virgula.
# Escopo unico: lancamento de pagamento ou recebimento (ttVendorPayment/ttReceipt) cuja linha
# aponte para uma regra de reparticao INATIVADA no SAP - situacao em que o Service Layer recusa
# qualquer update nesse lancamento, mesmo um PATCH que so marque o UDF de processado
# ("-5002 Inactive distribution rule"). So a dimensao inativa e trocada; a que continua valida
# fica como esta. Entrada com campo em branco e ignorada, e filial sem padrao nao e alterada.
#
# NAO e usado em nenhum outro cenario. O rateio de pedido de venda, cotacao e NF de compra tem
# configuracao propria e independente: distibuicao.custo (DistribuicaoCustoByBranchConfig), que
# e um JSON e nao este formato. Mexer numa nao altera a outra.
lc.centrodecusto.padrao-por-filial=2:500:50000205,4:501:50100401,11:502:50200501

# ----- Gateway de consultas SQL (sap-odbc) -----
# Usado pelo painel de vendas v2, que precisa AGREGAR no banco (GROUP BY, funcoes
# de data, janelas) - coisa que o SQLQueries do Service Layer nao aceita.
#
# Estas credenciais ficam APENAS aqui, no backend. O front-sap nunca fala com o
# sap-odbc: ele chama /painel-vendas/v2/** e este servico aplica o recorte de
# filial e vendedor antes de consultar. Se a chave fosse para o navegador,
# qualquer usuario a leria no devtools e consultaria o gateway direto, sem
# nenhum filtro de permissao.
odbc.base-url=http://localhost:8080
odbc.api-key=
# Timeout pedido ao gateway por consulta, em segundos.
odbc.query-timeout-seconds=30

# ----- Painel de vendas v2 -----
# Limita QUAIS filiais o painel pode consultar neste ambiente. E limite de
# deploy, nao permissao de usuario: nem o papel admin passa dele. A permissao
# por usuario (HEM10 / papel filial-N do Keycloak) continua valendo por cima.
# Vazio = sem restricao adicional.
painel-vendas.filiais=

# OTP de liberacao das travas (TransactionNotification). Deve ser IGUAL ao segredo
# da funcao HANA fnValidaOtpBypass (repo sap-sql-sovis). Troque em producao.
trava.otp.secret=TROCAR_ESTE_SEGREDO
trava.otp.window-seconds=120
trava.otp.length=6
# Provisiona/semeia o catalogo de regras de trava (UDO TRAVA_REGRA) no boot.
fields.trava=true
